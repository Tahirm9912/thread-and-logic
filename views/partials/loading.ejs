<div id="pageLoader" class="page-loader">
  <div class="loader-spinner">
    <i class="fas fa-spinner fa-spin"></i>
    <p>Loading...</p>
  </div>
</div>

<style>
.page-loader {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  opacity: 1;
  transition: opacity 0.3s;
}

.page-loader.hidden {
  opacity: 0;
  pointer-events: none;
}

.loader-spinner {
  text-align: center;
}

.loader-spinner i {
  font-size: 3rem;
  color: #1a1a1a;
  margin-bottom: 1rem;
}

.loader-spinner p {
  font-size: 1.2rem;
  color: #666;
}
</style>

<script>
window.addEventListener('load', function() {
  const loader = document.getElementById('pageLoader');
  if (loader) {
    loader.classList.add('hidden');
    setTimeout(() => loader.remove(), 300);
  }
});
</script>