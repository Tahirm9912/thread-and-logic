<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> - aynByHadiyaz</title>
  <link rel="shortcut icon" href="/images/icon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/product.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <meta name="<%= product.name %>" content="<%= product.description %>" />
</head>


<body>


<%- include('../partials/header-ns') %>
<%- include("../partials/breadcrumb") %>


<section class="product-page">


  <!-- LEFT SIDE - IMAGES -->
  <div class="product-images">

    <!-- MAIN IMAGE -->
    <div class="main-image">
      <% if (images && images.length > 0) { %>
        <img id="mainImg" src="<%= images[0].image_url %>" alt="<%= images[0].alt_text || product.name %>">
      <% } else { %>
        <img id="mainImg" src="/images/default.jpg" alt="<%= product.name %>">
      <% } %>
    </div>


    <!-- THUMBNAIL IMAGES -->
    <% if (images && images.length > 0) { %>
      <div class="thumbs">
        <% images.forEach((img, index) => { %>
          <img
            src="<%= img.image_url %>"
            alt="<%= img.alt_text || product.name %>"
            class="thumb <%= index === 0 ? 'active' : '' %>"
            onclick="changeImage(this)">
        <% }) %>
      </div>
    <% } %>


  </div>


  <!-- RIGHT SIDE - INFO -->
  <div class="product-info">
    <!-- rest of product info ... -->


    <h1><%= product.name %></h1>


<p id="price">Select options</p>


<!-- STOCK STATUS -->
<!-- <p id="stockStatus" class="stock-status"></p> -->


<p><%= product.description %></p>


    <% if (product.tags && product.tags.length > 0) { %>
      <div class="product-tags">
        <% product.tags.forEach(tag => { %>
          <a href="/list?tag=<%= tag %>" class="tag">
            <%= tag %>
          </a>
        <% }) %>
      </div>
    <% } %>


    <div class="product-options">


      <!-- SIZE -->
      <label>Size</label>
      <select id="sizeSelect">
        <% [...new Set(variants.map(v => v.size))].forEach(size => { %>
          <option value="<%= size %>"><%= size %></option>
        <% }) %>
      </select>


      <!-- COLOR -->
      <label>Color</label>
      <select id="colorSelect">
        <% [...new Set(variants.map(v => v.color))].forEach(color => { %>
          <option value="<%= color %>"><%= color %></option>
        <% }) %>
      </select>


      <!-- CUSTOMIZATION NOTE (Hidden by default) -->
      <div id="customizationNoteDiv" class="customization-note-input" style="display: none;">
        <label for="customizationNote">Customization Details (Size, Color, Requirements, etc.)</label>
        <textarea id="customizationNote" placeholder="Describe your customization requirements... e.g., Size: 24 inches, Color: Navy Blue, Extra large, etc." rows="4"></textarea>
      </div>


      <!-- QUANTITY -->
      <label>Quantity</label>
      <div class="qty-box">
        <button type="button" onclick="changeQty(-1)">-</button>
        <input type="number" id="qty" value="1" min="1">
        <button type="button" onclick="changeQty(1)">+</button>
      </div>


    </div>


    <div class="product-actions">
      <button id="addToCartBtn" class="btn-cart">Add to Cart</button>
      <button id="buyNowBtn" class="btn-buy">Buy Now</button>
    </div>


    <!-- WHATSAPP ORDER BUTTON -->
    <a href="javascript:void(0)"
       class="btn-whatsapp"
       id="whatsappOrderBtn">
      <i class="fab fa-whatsapp"></i> Order through WhatsApp
    </a>


  </div>


</section>


<!-- RELATED PRODUCTS -->
<% if (relatedProducts && relatedProducts.length > 0) { %>
<section class="related-products">
  <h2>You May Also Like</h2>

  <div class="related-grid">
    <% relatedProducts.forEach(product => { %>
      <div class="related-card">
        <a href="/product/<%= product.productid %>">
          <img src="<%= product.image_url || '/images/default.jpg' %>" alt="<%= product.name %>">
          <h3><%= product.name %></h3>
<p class="price">
  Rs <%= parseFloat(product.price).toLocaleString('en-PK', { maximumFractionDigits: 0 }) %>
</p>
        </a>
      </div>
    <% }) %>
  </div>
</section>
<% } %>


<%- include('../partials/menubar') %>
<%- include('../partials/cart') %>
<%- include('../partials/search') %>
<%- include('../partials/footer') %>
<%- include("../partials/whatsapp")%>


<script>
  // ===============================
  // 🟢 PRODUCT PAGE VARIANTS & FUNCTIONS
  // ===============================
  const variants = <%- JSON.stringify(variants) %>;


  const sizeSelect = document.getElementById("sizeSelect");
  const colorSelect = document.getElementById("colorSelect");
  const customizationNoteDiv = document.getElementById("customizationNoteDiv");
  const customizationNoteInput = document.getElementById("customizationNote");
  const priceEl = document.getElementById("price");
  const qtyInput = document.getElementById("qty");
  const addToCartBtn = document.getElementById("addToCartBtn");
  const buyNowBtn = document.getElementById("buyNowBtn");
  const stockStatus = document.getElementById('stockStatus');


  // ===============================
  // 🟢 HANDLE CUSTOMIZED SIZE/COLOR
  // ===============================
  function handleCustomizedOptions() {
    const size = sizeSelect.value;
    const color = colorSelect.value;

    // Check if size is "Customized" OR color is "Customized"
    const isCustomSize = size.toLowerCase().includes("customized") || size.toLowerCase().includes("custom");
    const isCustomColor = color.toLowerCase().includes("customized") || color.toLowerCase().includes("custom");

    if (isCustomSize || isCustomColor) {
      customizationNoteDiv.style.display = "block";
      addToCartBtn.disabled = true;
      addToCartBtn.innerHTML = '<i class="fas fa-exclamation-circle"></i> Custom Options - Use Buy Now or WhatsApp';
      addToCartBtn.title = "Custom options require manual confirmation";
    } else {
      customizationNoteDiv.style.display = "none";
      if (customizationNoteInput) customizationNoteInput.value = "";

      // Re-enable Add to Cart
      addToCartBtn.disabled = false;
      addToCartBtn.innerHTML = 'Add to Cart';
      addToCartBtn.title = "";
    }
  }


  sizeSelect.addEventListener("change", () => {
    handleCustomizedOptions();
    updateVariant();
  });

  colorSelect.addEventListener("change", () => {
    handleCustomizedOptions();
    updateVariant();
  });


  // UPDATE PRICE
  function updateVariant() {
    const size = sizeSelect.value;
    const color = colorSelect.value;

    let variant = null;

    const isCustomSize = size.toLowerCase().includes("customized") || size.toLowerCase().includes("custom");
    const isCustomColor = color.toLowerCase().includes("customized") || color.toLowerCase().includes("custom");

    if (isCustomSize) {
      variant = variants.find(v =>
        v.size.toLowerCase().includes("custom") && v.color === color
      );
    } else if (isCustomColor) {
      variant = variants.find(v =>
        v.size === size && v.color.toLowerCase().includes("custom")
      );
    } else {
      variant = variants.find(v => v.size === size && v.color === color);
    }


    if (variant) {
      priceEl.innerText = "Rs " + parseFloat(variant.price).toLocaleString('en-PK', {maximumFractionDigits:0});

      if (stockStatus) {
        if (variant.stock > 10) {
          stockStatus.innerHTML = '<span style="color: green;"><i class="fas fa-check-circle"></i> In Stock</span>';
        } else if (variant.stock > 0) {
          stockStatus.innerHTML = `<span style="color: orange;"><i class="fas fa-exclamation-triangle"></i> Only ${variant.stock} left!</span>`;
        } else {
          stockStatus.innerHTML = '<span style="color: red;"><i class="fas fa-times-circle"></i> Out of Stock</span>';
        }
      }
    } else {
      priceEl.innerText = "Not available";
      if (stockStatus) {
        stockStatus.innerHTML = '<span style="color: red;">Combination not available</span>';
      }
    }
  }


  updateVariant();


  // GET SELECTED VARIANT
  function getVariant() {
    const size = sizeSelect.value;
    const color = colorSelect.value;

    let variant = null;

    const isCustomSize = size.toLowerCase().includes("customized") || size.toLowerCase().includes("custom");
    const isCustomColor = color.toLowerCase().includes("customized") || color.toLowerCase().includes("custom");

    if (isCustomSize) {
      variant = variants.find(v =>
        v.size.toLowerCase().includes("custom") && v.color === color
      );
    } else if (isCustomColor) {
      variant = variants.find(v =>
        v.size === size && v.color.toLowerCase().includes("custom")
      );
    } else {
      variant = variants.find(v => v.size === size && v.color === color);
    }

    return variant;
  }


  // ===============================
  // 🟢 ADD TO CART
  // ===============================
  addToCartBtn.addEventListener('click', function() {
    const size = sizeSelect.value;
    const color = colorSelect.value;

    const isCustomSize = size.toLowerCase().includes("customized") || size.toLowerCase().includes("custom");
    const isCustomColor = color.toLowerCase().includes("customized") || color.toLowerCase().includes("custom");

    if (isCustomSize || isCustomColor) {
      alert("Custom options cannot be added to cart. Please use Buy Now or WhatsApp Order.");
      return;
    }

    const variant = getVariant();


    if (!variant) {
      alert("Please choose correct size and color");
      return;
    }


    const quantity = parseInt(qtyInput.value);


    addToCartBtn.disabled = true;
    addToCartBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';


    fetch("/cart/add", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        product_id: variant.product_id,
        variant_id: variant.variant_id,
        quantity: quantity
      })
    })
    .then(res => {
      if (res.redirected) {
        window.location.href = res.url;
        return null;
      }
      return res.json();
    })
    .then(data => {
      if (!data) return;


      if (data.success) {
        if (typeof addToCartAnimation === 'function') {
          addToCartAnimation();
        }

        if (typeof updateCartCount === 'function') {
          updateCartCount();
        }

        if (typeof updateCartDrawer === 'function') {
          updateCartDrawer();
        }


        addToCartBtn.disabled = false;
        addToCartBtn.innerHTML = 'Add to Cart';
      } else {
        alert(data.message);
        addToCartBtn.disabled = false;
        addToCartBtn.innerHTML = 'Add to Cart';
      }
    })
    .catch(err => {
      console.log(err);
      alert('Error adding to cart');
      addToCartBtn.disabled = false;
      addToCartBtn.innerHTML = 'Add to Cart';
    });
  });


// ===============================
// 🟢 BUY NOW - Direct to Payment
// ===============================
buyNowBtn.addEventListener('click', function() {
  const variant = getVariant();
  const size = sizeSelect.value;
  const color = colorSelect.value;
  const quantity = parseInt(qtyInput.value);
  const customizationNote = customizationNoteInput ? customizationNoteInput.value.trim() : "";
  
  // Check if order is customized (either size or color)
  const isCustomSize = size.toLowerCase().includes("customized") || size.toLowerCase().includes("custom");
  const isCustomColor = color.toLowerCase().includes("customized") || color.toLowerCase().includes("custom");
  const isCustom = isCustomSize || isCustomColor;


  if (!variant) {
    alert("Please select size and color");
    return;
  }


  buyNowBtn.disabled = true;
  buyNowBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';


  fetch("/buy-now", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      product_id: variant.product_id,
      variant_id: variant.variant_id,
      quantity: quantity,
      size: size,
      color: color,
      customizationNote: customizationNote,
      isCustom: isCustom
    })
  })
  .then(res => {
    if (res.redirected) {
      window.location.href = res.url;
      return null;
    }
    return res.json();
  })
  .then(data => {
    if (!data) return;


    if (data.success) {
      window.location.href = `/payout?order=${data.orderId}`;
    } else {
      alert(data.message);
      buyNowBtn.disabled = false;
      buyNowBtn.innerHTML = 'Buy Now';
    }
  })
  .catch(err => {
    console.log(err);
    alert('Error processing purchase');
    buyNowBtn.disabled = false;
    buyNowBtn.innerHTML = 'Buy Now';
  });
});




// ===============================
  // 🟢 WHATSAPP ORDER BUTTON
  // ===============================
  const whatsappOrderBtn = document.getElementById('whatsappOrderBtn');


  if (whatsappOrderBtn) {
    whatsappOrderBtn.addEventListener('click', function() {
      const currentPageUrl = window.location.href;
      const currentPageTitle = document.title;
      const whatsappNumber = '923166389642';

      const size = sizeSelect.value;
      const color = colorSelect.value;
      const quantity = qtyInput.value;
      const customizationNote = customizationNoteInput ? customizationNoteInput.value.trim() : "";

      let message = `I want to order this product:\n\n`;
      message += `Product: ${currentPageTitle}\n`;
      message += `Size: ${size}\n`;
      message += `Color: ${color}\n`;
      message += `Quantity: ${quantity}\n\n`;

      if (customizationNote) {
        message += `📝 Customization Details:\n${customizationNote}\n`;
      }

      message += `\nURL: ${currentPageUrl}`;

      const whatsappURL = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
      window.open(whatsappURL, '_blank');
    });
  }


  // ===============================
  // 🟢 OTHER FUNCTIONS
  // ===============================
  function changeImage(el) {
    document.getElementById("mainImg").src = el.src;
    document.querySelectorAll(".thumb").forEach(t => t.classList.remove("active"));
    el.classList.add("active");
  }


  function changeQty(val) {
    let v = parseInt(qtyInput.value);
    v += val;
    if (v < 1) v = 1;
    qtyInput.value = v;
  }


  function updateCartCount() {
    fetch('/api/cart-count')
      .then(res => res.json())
      .then(data => {
        const badge = document.querySelector('.cart-badge');
        const wrapper = document.querySelector('.cart-wrapper');

        if (data.count > 0) {
          if (badge) {
            badge.textContent = data.count;
          } else {
            const newBadge = document.createElement('span');
            newBadge.className = 'cart-badge';
            newBadge.textContent = data.count;
            wrapper.appendChild(newBadge);
          }
          wrapper.classList.add('active');
        }
      })
      .catch(err => console.error(err));
  }


  function updateCartDrawer() {
    fetch('/api/cart-items')
      .then(res => res.json())
      .then(data => {
        const cartBody = document.querySelector('.cart-drawer .cart-body');

        if (!cartBody) return;


        if (data.items && data.items.length > 0) {
          cartBody.innerHTML = data.items.map(item => `
            <div class="cart-item">
              <img src="${item.image_url || '/images/default.jpg'}" alt="${item.name}">
              <div class="cart-item-info">
                <h4>${item.name}</h4>
                <p>${item.size} • ${item.color}</p>
                ${item.customizationNote ? `<p><small>📝 Customization: ${item.customizationNote}</small></p>` : ''}
                <p class="cart-price">Rs ${parseFloat(item.price).toFixed(0)}</p>
              </div>
              <div class="cart-qty">
                <span>Qty: ${item.quantity}</span>
              </div>
            </div>
            `).join('');


          let footer = document.querySelector('.cart-drawer .cart-footer');
          if (!footer) {
            footer = document.createElement('div');
            footer.className = 'cart-footer';
            document.querySelector('.cart-drawer').appendChild(footer);
          }
          footer.innerHTML = '<a href="/checkout" class="cart-checkout-btn">Checkout</a>';
        }
      })
      .catch(err => console.error(err));
  }


  function addToCartAnimation() {
    const cartIcon = document.querySelector('.cart-icon');
    const cartWrapper = document.querySelector('.cart-wrapper');

    if (!cartIcon) return;


    cartIcon.classList.add('cart-shake');


    if (cartWrapper) {
      cartWrapper.classList.add('active');
    }


    const sound = new Audio('/sounds/cart.mp3');
    sound.play().catch(() => {});


    setTimeout(() => {
      cartIcon.classList.remove('cart-shake');
    }, 400);
  }


  // ===============================
  // 🟢 SIDE MENU, CART, SEARCH, WHATSAPP CHAT (Same as before)
  // ===============================
  const menu = document.getElementById("sideMenu");
  const overlay = document.getElementById("overlay");
  const toggle = document.getElementById("menuToggle");


  if (toggle) {
    toggle.addEventListener("click", () => {
      menu.classList.toggle("active");
      overlay.classList.toggle("active");
      toggle.classList.toggle("fa-bars");
      toggle.classList.toggle("fa-times");
    });
  }


  if (overlay) {
    overlay.addEventListener("click", () => {
      menu.classList.remove("active");
      overlay.classList.remove("active");
      if (toggle) {
        toggle.classList.add("fa-bars");
        toggle.classList.remove("fa-times");
      }
    });
  }


  const cartDrawer = document.getElementById("cartDrawer");
  const cartOverlay = document.getElementById("cartOverlay");
  const cartIcon = document.querySelector(".cart-icon");


  if (cartIcon) {
    cartIcon.addEventListener("click", () => {
      if (cartDrawer) cartDrawer.classList.add("active");
      if (cartOverlay) cartOverlay.classList.add("active");
    });
  }


  if (cartOverlay) {
    cartOverlay.addEventListener("click", () => {
      if (cartDrawer) cartDrawer.classList.remove("active");
      cartOverlay.classList.remove("active");
    });
  }


  const searchBtn = document.getElementById("search_top");
  const searchOverlay = document.getElementById("searchOverlay");
  const searchInput = document.getElementById("searchInput");
  const searchClose = document.getElementById("searchClose");


  if (searchBtn && searchOverlay) {
    searchBtn.addEventListener("click", () => {
      searchOverlay.classList.add("active");
      if (searchInput) searchInput.focus();
    });
  }


  function closeSearch() {
    if (searchOverlay) searchOverlay.classList.remove("active");
    if (searchInput) searchInput.value = "";
  }


  if (searchClose) {
    searchClose.addEventListener("click", closeSearch);
  }


  if (searchInput) {
    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        const query = searchInput.value.trim();
        if (query !== "") {
          window.location.href = `/list?search=${encodeURIComponent(query)}`;
        }
      }
    });
  }


  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeSearch();
      if (cartDrawer) cartDrawer.classList.remove("active");
      if (cartOverlay) cartOverlay.classList.remove("active");
      if (menu) menu.classList.remove("active");
      if (overlay) overlay.classList.remove("active");
      if (toggle) {
        toggle.classList.add("fa-bars");
        toggle.classList.remove("fa-times");
      }
    }
  });


  const mainImg = document.getElementById("mainImg");
  const thumbs = document.querySelectorAll(".thumb");


  thumbs.forEach(img => {
    img.addEventListener("click", () => {
      if (mainImg) mainImg.src = img.src;
      thumbs.forEach(t => t.classList.remove("active"));
      img.classList.add("active");
    });
  });


  const whatsappToggle = document.getElementById('whatsappToggle');
  const whatsappDrawer = document.getElementById('whatsappDrawer');
  const whatsappOverlay = document.getElementById('whatsappOverlay');
  const whatsappClose = document.getElementById('whatsappClose');
  const whatsappSend = document.getElementById('whatsappSend');
  const whatsappMessage = document.getElementById('whatsappMessage');


  const WHATSAPP_NUMBER = '923166389642';


  function toggleWhatsapp() {
    if (whatsappDrawer && whatsappDrawer.classList.contains('active')) {
      whatsappDrawer.classList.remove("active");
      if (whatsappOverlay) whatsappOverlay.classList.remove("active");
    } else {
      if (whatsappDrawer) whatsappDrawer.classList.add("active");
      if (whatsappOverlay) whatsappOverlay.classList.add("active");
      if (whatsappMessage) whatsappMessage.focus();
    }
  }


  if (whatsappToggle) {
    whatsappToggle.addEventListener('click', toggleWhatsapp);
  }


  if (whatsappClose) {
    whatsappClose.addEventListener('click', toggleWhatsapp);
  }


  if (whatsappOverlay) {
    whatsappOverlay.addEventListener('click', toggleWhatsapp);
  }


  if (whatsappSend) {
    whatsappSend.addEventListener('click', () => {
      const message = whatsappMessage.value.trim();

      if (!message) {
        alert('Please enter a message');
        if (whatsappMessage) whatsappMessage.focus();
        return;
      }

      const currentPageUrl = window.location.href;
      const currentPageTitle = document.title;
      const size = sizeSelect.value;
      const color = colorSelect.value;

      const formattedMessage =
          `Message: ${message}\n\n` +
          `Product: ${currentPageTitle}\n` +
          `Size: ${size}\n` +
          `Color: ${color}\n\n` +
          `URL: ${currentPageUrl}`;

      const whatsappURL = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(formattedMessage)}`;

      whatsappSend.disabled = true;
      whatsappSend.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Opening...';

      setTimeout(() => {
        window.open(whatsappURL, '_blank');
        whatsappSend.disabled = false;
        whatsappSend.innerHTML = '<i class="fas fa-paper-plane"></i> Send to WhatsApp';
        toggleWhatsapp();
        if (whatsappMessage) whatsappMessage.value = '';
      }, 1000);
    });
  }


  document.querySelectorAll(".dropdown").forEach(d => {
    const btn = d.querySelector(".drop-btn");
    if (btn) {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        d.classList.toggle("active");
      });
    }
  });


  function trackRecentlyViewed(productId) {
    let recent = JSON.parse(localStorage.getItem('recentlyViewed') || '[]');
    recent = recent.filter(id => id !== productId);
    recent.unshift(productId);
    recent = recent.slice(0, 10);
    localStorage.setItem('recentlyViewed', JSON.stringify(recent));
  }


  const productId = <%= product.productid %>;
  trackRecentlyViewed(productId);


</script>


</body>
</html>