<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %></title>

  <link rel="shortcut icon" href="/resources/favicon.ico">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/product.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>

<%- include('../partials/header') %>

<section class="product-page">

  <!-- LEFT -->
  <div class="product-images">
    <div class="main-image">
      <img id="mainImg" src="<%= images[0]?.image_url %>">
    </div>

    <div class="thumbs">
      <% images.forEach((img, i) => { %>
        <img 
          src="<%= img.image_url %>" 
          class="thumb <%= i === 0 ? 'active' : '' %>"
          onclick="changeImage(this)">
      <% }) %>
    </div>
  </div>

  <!-- RIGHT -->
  <div class="product-info">

    <h1><%= product.name %></h1>

    <p id="price">Select options</p>

    <p><%= product.description %></p>


    <!-- 🔥 TAGS SECTION (NEW) -->
<% const tags = Array.isArray(product.tags)
  ? product.tags
  : (product.tags ? product.tags.split(',') : []);
%>

<% if (product.tags && product.tags.length > 0) { %>

  <div class="product-tags">
    <% product.tags.forEach(tag => { %>
      <a href="/list?tag=<%= tag %>" class="tag">
        <%= tag %>
      </a>
    <% }) %>
  </div>

<% } %>


    <div class="product-options">

      <!-- SIZE -->
      <label>Size</label>
      <select id="sizeSelect">
        <% [...new Set(variants.map(v => v.size))].forEach(size => { %>
          <option value="<%= size %>"><%= size %></option>
        <% }) %>
      </select>

      <!-- COLOR -->
      <label>Color</label>
      <select id="colorSelect">
        <% [...new Set(variants.map(v => v.color))].forEach(color => { %>
          <option value="<%= color %>"><%= color %></option>
        <% }) %>
      </select>

      <!-- QUANTITY -->
      <label>Quantity</label>
      <div class="qty-box">
        <button type="button" onclick="changeQty(-1)">-</button>
        <input type="number" id="qty" value="1" min="1">
        <button type="button" onclick="changeQty(1)">+</button>
      </div>

    </div>

    <div class="product-actions">
      <button onclick="handleAddToCart()" class="btn-cart">Add to Cart</button>
      <button class="btn-buy">Buy Now</button>
    </div>

  </div>

</section>

<%- include('../partials/menubar') %>
<%- include('../partials/cart') %>
<%- include('../partials/search') %>
<%- include('../partials/footer') %>

<script>
  const variants = <%- JSON.stringify(variants) %>;

  const sizeSelect = document.getElementById("sizeSelect");
  const colorSelect = document.getElementById("colorSelect");
  const priceEl = document.getElementById("price");
  const qtyInput = document.getElementById("qty");

  // 🔥 UPDATE PRICE
  function updateVariant() {
    const variant = variants.find(v =>
      v.size === sizeSelect.value &&
      v.color === colorSelect.value
    );

    if (variant) {
      priceEl.innerText = "Rs " + variant.price;
    } else {
      priceEl.innerText = "Not available";
    }
  }

  sizeSelect.addEventListener("change", updateVariant);
  colorSelect.addEventListener("change", updateVariant);

  updateVariant();

  // 🔥 GET SELECTED VARIANT
  function getVariant() {
    return variants.find(v =>
      v.size === sizeSelect.value &&
      v.color === colorSelect.value
    );
  }

  // 🔥 ADD TO CART
  function handleAddToCart() {

    const variant = getVariant();

    if (!variant) {
      alert("Combination not available");
      return;
    }

    const quantity = parseInt(qtyInput.value);

    fetch("/cart/add", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        product_id: variant.product_id,
        variant_id: variant.variant_id,
        quantity: quantity
      })
    })
    .then(res => {
      if (res.redirected) {
        window.location.href = res.url;
        return;
      }
      return res.json();
    })
    .then(data => {
      if (!data) return;

      if (data.success) {
        addToCartAnimation();
      } else {
        alert(data.message);
      }
    })
    .catch(err => console.log(err));
  }

  // IMAGE
  function changeImage(el) {
    document.getElementById("mainImg").src = el.src;
    document.querySelectorAll(".thumb").forEach(t => t.classList.remove("active"));
    el.classList.add("active");
  }

  // QTY
  function changeQty(val) {
    let v = parseInt(qtyInput.value);
    v += val;
    if (v < 1) v = 1;
    qtyInput.value = v;
  }
</script>

<script src="/js/product.js"></script>

</body>
</html>