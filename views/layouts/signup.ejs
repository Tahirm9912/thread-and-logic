<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Ayn By Hadiyaz</title>
    <link rel="shortcut icon" href="/resources/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/signup.css">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="shortcut icon" href="/images/icon.ico" type="image/x-icon">
</head>

<body>

<%- include("../partials/header-nscm") %>

<section class="auth-section">

  <div class="auth-container">

    <h2>Create Account</h2>

    <form action="/api/auth/register" method="POST" class="auth-form">

      <!-- HIDDEN FIELD: Store returnUrl -->
      <input type="hidden" name="returnUrl" value="<%= returnUrl %>">

      <!-- NAME -->
      <div class="form-group">
        <label>Full Name</label>
        <input name="name" type="text" placeholder="Enter your name" required>
      </div>

      <!-- EMAIL -->
      <div class="form-group">
        <label>Email</label>
        <input name="email" type="email" placeholder="Enter your email" required>
      </div>

      <!-- PHONE -->
      <div class="form-group">
        <label>Phone Number</label>
        <input name="tel" type="tel" placeholder="03XXXXXXXXX" required>
      </div>

      <!-- ADDRESS -->
      <div class="form-group">
        <label>Address</label>
        <textarea name="address" placeholder="Enter your complete address" required></textarea>
      </div>

      <!-- POSTAL CODE -->
      <div class="form-group">
        <label>Postal Code</label>
        <input name="postal_code" type="text" placeholder="49500" required>
      </div>

      <!-- PASSWORD -->
      <div class="form-group">
        <label>Password</label>
        <input name="password" type="password" placeholder="Enter password (min 8 characters)" minlength="8" required>
      </div>

      <!-- CHECKBOXES -->
      <div class="form-check">
        <label>
          <input type="checkbox" required>
          I agree to <a href="/terms-and-conditions" class="link">Terms & Conditions</a>
        </label>
      </div>

      <div class="form-check">
        <label>
          <input name="allow_promotions" type="checkbox">
          Receive promotional messages
        </label>
      </div>

      <!-- BUTTON -->
      <button type="submit" class="auth-btn">Create Account</button>

      <% if (error) { %>
        <div class="auth-message" id="notification_pan">
          <div class="message error">
            <%= error %>
          </div>
        </div>
      <% } %>

    </form>

    <p class="auth-switch">
      Already have an account? 
      <a href="/login?returnUrl=<%= encodeURIComponent(returnUrl) %>">Sign In</a>
    </p>

  </div>

</section>

<script>
  const pan = document.getElementById("notification_pan");
  if (pan) {
    setTimeout(() => {
      pan.classList.add("hidden");
    }, 3000);
  }
</script>

</body>
</html>