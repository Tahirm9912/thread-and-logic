<script>
  const signupForm = document.getElementById('signupForm');
  const countryCodeSelect = document.getElementById('countryCode');
  const phoneNumberInput = document.getElementById('phoneNumber');
  const fullPhoneInput = document.getElementById('fullPhone');

  // Set default to Pakistan
  if (countryCodeSelect) {
    countryCodeSelect.value = "+92";
  }

  if (signupForm) {
    signupForm.addEventListener('submit', function(e) {
      const countryCode = countryCodeSelect.value;
      const phoneNumber = phoneNumberInput.value.trim();

      if (!phoneNumber) {
        alert('Please enter your phone number');
        phoneNumberInput.focus();
        e.preventDefault();
        return false;
      }

      // Remove spaces, dashes, parentheses from phone number
      const cleanPhoneNumber = phoneNumber.replace(/[\s\-\(\)]/g, '');
      
      // Concatenate country code with phone number
      const fullPhoneNumber = countryCode + cleanPhoneNumber;

      // Set the hidden input value
      fullPhoneInput.value = fullPhoneNumber;

      console.log('Full phone number:', fullPhoneNumber);
      
      return true;
    });
  }

  // Hide notification after 3 seconds
  const pan = document.getElementById("notification_pan");
  if (pan) {
    setTimeout(() => {
      pan.classList.add("hidden");
    }, 3000);
  }
</script>



