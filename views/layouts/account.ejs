<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Account</title>

  <link rel="stylesheet" href="/css/account.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>

<%- include('../partials/header-ns') %>

<section class="account-section">

  <div class="account-container">

    <!-- USER INFO -->
    <div class="account-info">

      <div class="account-header">
        <h2 class="account-name"><%= user.name %></h2>

        <button onclick="toggleEdit()" class="edit-btn">
          Edit Info
        </button>
      </div>

      <!-- VIEW MODE -->
      <div id="viewMode" class="info-grid">
        <p><strong>Email:</strong> <%= user.email %></p>
        <p><strong>Phone:</strong> <%= user.phone || '-' %></p>
        <p><strong>Address:</strong> <%= user.address || '-' %></p>
      </div>

      <!-- EDIT MODE -->
      <form id="editForm" class="info-grid" style="display:none;" onsubmit="updateProfile(event)">

        <p>
          <strong>Email:</strong><br>
          <input type="email" name="email" value="<%= user.email %>">
        </p>

        <p>
          <strong>Phone:</strong><br>
          <input type="text" name="phone" value="<%= user.phone || '' %>">
        </p>

        <p>
          <strong>Address:</strong><br>
          <input type="text" name="address" value="<%= user.address || '' %>">
        </p>

        <button type="submit" class="save-btn">Save</button>

      </form>

    </div>

    <!-- ORDER HISTORY -->
    <div class="order-history">

      <h3>Order History</h3>

      <div class="table-wrapper">

        <table class="order-table">

          <thead>
            <tr>
              <th>#</th>
              <th>Image</th>
              <th>Product</th>
              <th>Date</th>
              <th>Status</th>
            </tr>
          </thead>

          <tbody>

            <% if (orders && orders.length > 0) { %>

              <% let i = 1 %>

              <% orders.forEach(order => { %>

                <% order.items.forEach(item => { %>

                  <tr>
                    <td><%= i++ %></td>

                    <td>
                      <img src="<%= item.image_url || '/images/default.jpg' %>" width="60">
                    </td>

                    <td>
                      <%= item.name %>
                    </td>

                    <td>
                      <%= new Date(order.created_at).toDateString() %>
                    </td>

                    <td class="status <%= order.status %>">
                      <%= order.status %>
                    </td>

                  </tr>

                <% }) %>

              <% }) %>

            <% } else { %>

              <tr>
                <td colspan="5">No orders yet</td>
              </tr>

            <% } %>

          </tbody>

        </table>

      </div>

    </div>

  </div>

</section>

<%- include('../partials/menubar') %>
<%- include('../partials/cart') %>
<%- include('../partials/footer') %>

<script src="/js/account.js"></script>

</body>
</html>