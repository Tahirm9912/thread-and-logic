<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>aynByHadiyaz - Premium Pakistani Fashion</title>
  <link rel="shortcut icon" href="/images/icon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/main.css">
    
</head>

<body>

<%- include('../partials/header') %>

<!-- HERO -->
<!-- HERO -->
<section class="hero reveal">
  <div class="slider">
    <a href="/list">
      <div class="slides">
        <% carousel_images.forEach((img, index) => { %>
          <img src="<%= img %>" class="slide <%= index === 0 ? 'active' : '' %>" alt="Slide <%= index + 1 %>">
        <% }) %>
      </div>
    </a>
    <button class="prev">&#10094;</button>
    <button class="next">&#10095;</button>
    <div class="dots"></div>
  </div>
</section>

<!-- Later in the file -->
<% if (popup_enabled) { %>
<div class="popup-overlay" id="popup">
  <div class="popup-box">
    <span class="popup-close" id="popupClose">&times;</span>
    <img src="<%= popup_image %>" alt="Popup" class="popup-img">
    <a href="/list" class="popup-btn">Shop Now</a>
  </div>
</div>
<% } %>

<!-- CATEGORIES -->
<section class="categories reveal">
  <h2 class="cat-heading">Shop by Categories</h2>
  <div class="cat-grid">
    <a href="/list?tag=new" class="cat-item">
      <div class="cat-circle"><img src="/images/image 1.jpg" alt="New Arrivals"></div>
      <span>New Arrivals</span>
    </a>
    <a href="/list?tag=summer" class="cat-item">
      <div class="cat-circle"><img src="/images/image 2.jpg" alt="Summer"></div>
      <span>Summer Collection</span>
    </a>
    <a href="/list?tag=formal" class="cat-item">
      <div class="cat-circle"><img src="/images/a.webp" alt="Formal"></div>
      <span>Formal Wear</span>
    </a>
  </div>
</section>

<!-- TRENDING -->
<section class="trending reveal">
  <h2 class="trend-heading">Trending Now</h2>

  <div class="trend-grid" id="trendingProducts">
    <!-- Products will load here -->
    <p>Loading products...</p>
  </div>
</section>

<%- include('../partials/menubar') %>
<%- include('../partials/cart') %>
<%- include('../partials/search') %>
<%- include('../partials/footer') %>

<!-- POPUP -->
<div class="popup-overlay" id="popup">
  <div class="popup-box">
    <span class="popup-close" id="popupClose">&times;</span>
    <img src="/images/a.webp" alt="Popup" class="popup-img">
    <a href="/list" class="popup-btn">Shop Now</a>
  </div>
</div>

<script src="/js/home.js"></script>

<script>
// Load trending products
fetch('/api/trending-products')
  .then(res => res.json())
  .then(data => {
    const container = document.getElementById('trendingProducts');
    
    if (data.products && data.products.length > 0) {
      container.innerHTML = data.products.map(product => `
        <div class="trend-card">
          <a href="/product/${product.productid}" class="trend-link">
            <img src="${product.image_url || '/images/default.jpg'}" alt="${product.name}">
          </a>

          <div class="trend-info">
            <h3>
              <a href="/product/${product.productid}" class="trend-link">${product.name}</a>
            </h3>

            <p class="price">Rs ${parseFloat(product.price).toFixed(0)}</p>

            <div class="trend-actions">
              <button onclick="quickAddToCart(${product.productid}, ${product.variant_id})" class="btn-cart">
                Add to Cart
              </button>
              <a href="/product/${product.productid}" class="btn-buy">View Details</a>
            </div>
          </div>
        </div>
      `).join('');
    } else {
      container.innerHTML = '<p>No trending products available</p>';
    }
  })
  .catch(err => {
    console.error(err);
    document.getElementById('trendingProducts').innerHTML = '<p>Error loading products</p>';
  });

// Quick add to cart
function quickAddToCart(productId, variantId) {
  if (!variantId) {
    window.location.href = `/product/${productId}`;
    return;
  }

  fetch('/cart/add', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      product_id: productId,
      variant_id: variantId,
      quantity: 1
    })
  })
  .then(res => {
    if (res.redirected) {
      window.location.href = res.url;
      return;
    }
    return res.json();
  })
  .then(data => {
    if (!data) return;
    
    if (data.success) {
      addToCartAnimation();
      setTimeout(() => location.reload(), 500);
    } else {
      alert(data.message || 'Error adding to cart');
    }
  })
  .catch(err => {
    console.error(err);
    alert('Error adding to cart');
  });
}

window.quickAddToCart = quickAddToCart;
</script>

</body>
</html>