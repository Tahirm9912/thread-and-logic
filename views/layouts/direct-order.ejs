<%- include("../partials/header-nscm") %>



<section class="direct-order-section">
  
  <div class="direct-order-container">
    
    <h2>Complete Your Order</h2>
    <p class="subtitle">Please fill in your details to proceed with payment</p>

    <!-- ORDER SUMMARY -->
    <div class="order-summary">
      <h3>Order Summary</h3>
      <div class="summary-item">
        <img src="<%= productImage %>" alt="<%= product.name %>">
        <div class="summary-details">
          <h4><%= product.name %></h4>
          <p>Size: <span id="summarySize"><%= size %></span></p>
          <p>Color: <span id="summaryColor"><%= color %></span></p>
          <p>Quantity: <span id="summaryQty"><%= quantity %></span></p>
          <% if (customizationNote) { %>
            <p class="customization-note">📝 Customization: <%= customizationNote %></p>
          <% } %>
          <p class="summary-price">Rs <%= parseFloat(totalAmount).toFixed(0) %></p>
        </div>
      </div>
    </div>

    <!-- CUSTOMER FORM -->
    <form id="directOrderForm" class="customer-form" action="/direct-order/submit" method="POST">
      
      <!-- HIDDEN FIELDS -->
      <input type="hidden" name="product_id" value="<%= productId %>">
      <input type="hidden" name="variant_id" value="<%= variantId %>">
      <input type="hidden" name="quantity" value="<%= quantity %>">
      <input type="hidden" name="size" value="<%= size %>">
      <input type="hidden" name="color" value="<%= color %>">
      <input type="hidden" name="customization_note" value="<%= customizationNote || '' %>">
      <input type="hidden" name="is_custom" value="<%= isCustom %>">
      <input type="hidden" name="total_amount" value="<%= totalAmount %>">

      <!-- NAME -->
      <div class="form-group">
        <label>Full Name</label>
        <input name="customer_name" type="text" placeholder="Enter your full name" required>
      </div>

      <!-- EMAIL -->
      <div class="form-group">
        <label>Email</label>
        <input name="customer_email" type="email" placeholder="Enter your email" required>
      </div>

      <!-- PHONE WITH COMPLETE COUNTRY CODE LIST -->
