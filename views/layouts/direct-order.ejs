<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Complete Your Order - Ayn By Hadiyaz</title>
  <link rel="shortcut icon" href="/images/icon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/direct-order.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>


<body>


<%- include("../partials/header-nscm") %>


<section class="direct-order-section">
  
  <div class="direct-order-container">
    
    <h2>Complete Your Order</h2>
    <p class="subtitle">Please fill in your details to proceed with payment</p>


    <!-- ORDER SUMMARY -->
    <div class="order-summary">
      <h3>Order Summary</h3>
      <div class="summary-item">
        <img src="<%= productImage %>" alt="<%= product.name %>">
        <div class="summary-details">
          <h4><%= product.name %></h4>
          <p>Size: <span id="summarySize"><%= size %></span></p>
          <p>Color: <span id="summaryColor"><%= color %></span></p>
          <p>Quantity: <span id="summaryQty"><%= quantity %></span></p>
          <% if (customizationNote) { %>
            <p class="customization-note">📝 Customization: <%= customizationNote %></p>
          <% } %>
          <p class="summary-price">Rs <%= parseFloat(totalAmount).toFixed(0) %></p>
        </div>
      </div>
    </div>


    <!-- CUSTOMER FORM -->
    <form id="directOrderForm" class="customer-form" action="/direct-order/submit" method="POST">
      
      <!-- HIDDEN FIELDS -->
      <input type="hidden" name="product_id" value="<%= productId %>">
      <input type="hidden" name="variant_id" value="<%= variantId %>">
      <input type="hidden" name="quantity" value="<%= quantity %>">
      <input type="hidden" name="size" value="<%= size %>">
      <input type="hidden" name="color" value="<%= color %>">
      <input type="hidden" name="customization_note" value="<%= customizationNote || '' %>">
      <input type="hidden" name="is_custom" value="<%= isCustom %>">
      <input type="hidden" name="total_amount" value="<%= totalAmount %>">


      <!-- NAME -->
      <div class="form-group">
        <label>Full Name</label>
        <input name="customer_name" type="text" placeholder="Enter your full name" required>
      </div>


      <!-- EMAIL -->
      <div class="form-group">
        <label>Email</label>
        <input name="customer_email" type="email" placeholder="Enter your email" required>
      </div>


      <!-- PHONE WITH COUNTRY CODE -->
      <div class="form-group">
        <label>Phone Number</label>
        <div class="phone-input-group">
          <select id="countryCode" class="country-code-select">
            <option value="+92">🇵🇰 +92</option>
            <option value="+1">🇺🇸 +1</option>
            <option value="+44">🇬🇧 +44</option>
            <option value="+91">🇮🇳 +91</option>
            <option value="+61">🇦🇺 +61</option>
            <option value="+49">🇩🇪 +49</option>
            <option value="+971">🇦🇪 +971</option>
            <option value="+966">🇸🇦 +966</option>
            <option value="+20">🇪🇬 +20</option>
            <option value="+55">🇧🇷 +55</option>
            <option value="+86">🇨🇳 +86</option>
            <option value="+81">🇯🇵 +81</option>
            <option value="+7">🇷🇺 +7</option>
            <option value="+82">🇰🇷 +82</option>
            <option value="+65">🇸🇬 +65</option>
            <option value="+60">🇲🇾 +60</option>
            <option value="+63">🇵🇭 +63</option>
            <option value="+84">🇻🇳 +84</option>
            <option value="+234">🇳🇬 +234</option>
            <option value="+52">🇲🇽 +52</option>
          </select>
          <input name="customer_phone" id="phoneNumber" type="tel" placeholder="Enter your phone number" required>
        </div>
      </div>


      <!-- ADDRESS -->
      <div class="form-group">
        <label>Complete Address</label>
        <textarea name="customer_address" placeholder="House #, Street, Area, City" required></textarea>
      </div>


      <!-- POSTAL CODE -->
      <div class="form-group">
        <label>Postal Code</label>
        <input name="postal_code" type="text" placeholder="Enter postal code">
      </div>


      <!-- CHECKBOX -->
      <div class="form-check">
        <label>
          <input type="checkbox" name="allow_promotions">
          Receive promotional messages
        </label>
      </div>


      <!-- BUTTON -->
      <button type="submit" class="submit-btn">
        <i class="fas fa-lock"></i> Proceed to Payment
      </button>


    </form>


  </div>


</section>


<%- include("../partials/footer") %>


<script>
  const directOrderForm = document.getElementById('directOrderForm');
  const countryCodeSelect = document.getElementById('countryCode');
  const phoneNumberInput = document.getElementById('phoneNumber');


  if (directOrderForm) {
    directOrderForm.addEventListener('submit', function(e) {
      const countryCode = countryCodeSelect.value;
      const phoneNumber = phoneNumberInput.value.trim();


      if (!phoneNumber) {
        e.preventDefault();
        alert('Please enter your phone number');
        phoneNumberInput.focus();
        return false;
      }


      const cleanPhoneNumber = phoneNumber.replace(/[\s\-\(\)]/g, '');
      const fullPhoneNumber = countryCode + cleanPhoneNumber;


      const phoneInput = document.createElement('input');
      phoneInput.type = 'hidden';
      phoneInput.name = 'customer_phone';
      phoneInput.value = fullPhoneNumber;
      directOrderForm.appendChild(phoneInput);


      return true;
    });
  }
</script>


</body>
</html>