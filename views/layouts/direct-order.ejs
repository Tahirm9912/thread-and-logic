  const directOrderForm = document.getElementById('directOrderForm');
  const countryCodeSelect = document.getElementById('countryCode');
  const phoneNumberInput = document.getElementById('phoneNumber');

  // Set default to Pakistan
  if (countryCodeSelect) {
    countryCodeSelect.value = "+92";
  }

  if (directOrderForm) {
    directOrderForm.addEventListener('submit', function(e) {
      const countryCode = countryCodeSelect.value;
      const phoneNumber = phoneNumberInput.value.trim();

      if (!phoneNumber) {
        e.preventDefault();
        alert('Please enter your phone number');
        phoneNumberInput.focus();
        return false;
      }

      const cleanPhoneNumber = phoneNumber.replace(/[\s\-\(\)]/g, '');
      const fullPhoneNumber = countryCode + cleanPhoneNumber;

      const phoneInput = document.createElement('input');
      phoneInput.type = 'hidden';
      phoneInput.name = 'customer_phone';
      phoneInput.value = fullPhoneNumber;
      directOrderForm.appendChild(phoneInput);

      return true;
    });
  }
</script>



</body>
</html>